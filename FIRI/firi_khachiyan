function FIRI_main
    % FIRI_main.m
    % Complete implementation of the 2-D FIRI algorithm with all helper functions
    
    close all; clear; clc;
    import casadi.*

    %% Environment parameters
    env_size = [50, 50];          % 50m x 50m environment
    num_obstacles = 30;           % Number of convex obstacles
    min_spacing = 0.3;            % Minimum spacing between obstacles
    seed_spacing = 2.0;           % Minimum spacing from seed to obstacles

    %% Seed parameters (rectangle)
    seed_vertices = [14 24; 16 24; 16 26; 14 26]; % Rectangle vertices
    seed = seed_vertices;

    %% Generate obstacles
    convex_obstacles = generate_nonoverlapping_obstacles(env_size, num_obstacles, min_spacing, seed, seed_spacing);

    %% Plot environment
    figure; hold on; grid on; axis equal;
    xlim([0, env_size(1)]); ylim([0, env_size(2)]);
    xlabel('X (m)'); ylabel('Y (m)');
    title('FIRI Algorithm: Environment and Results');

    % Plot obstacles
    for i = 1:numel(convex_obstacles)
        obs = convex_obstacles{i};
        if size(unique(obs, 'rows'), 1) >= 3
            k = convhull(obs(:,1), obs(:,2));
            fill(obs(k,1), obs(k,2), 'r', 'FaceAlpha', 0.3, 'EdgeColor', 'k');
        end
    end

    % Plot seed
    fill(seed(:,1), seed(:,2), 'b', 'FaceAlpha', 0.5, 'EdgeColor', 'b');

    %% Run FIRI algorithm
    % Initial ellipse: minimum volume enclosing ellipse of seed
    [L0, d0] = min_vol_ellipse(seed', 0.01);
    
    % Run FIRI
    [Pk, E_final, iter] = FIRI(seed, convex_obstacles, L0, d0, 1e-5, 10);
    disp(['FIRI converged in ' num2str(iter) ' iterations.']);

    %% Plot results
    if ~isempty(Pk)
        % Convert H-rep to V-rep
        vertices = lcon2vert(Pk.A, Pk.b)';
        if ~isempty(vertices)
            k = convhull(vertices(:,1), vertices(:,2));
            plot(vertices(k,1), vertices(k,2), 'm-', 'LineWidth', 2);
            fill(vertices(k,1), vertices(k,2), 'm', 'FaceAlpha', 0.2);
        end
    end
    
    % Plot final ellipse
    draw_ellipse(E_final.L, E_final.d);

    hold off;

    %% ----------------- Helper Functions ----------------- %%
    
    %% FIRI Main Algorithm
    function [Pk, E_final, iter] = FIRI(seed, obstacles, L0, d0, tol, max_iters)
        E.L = L0;
        E.d = d0;
        iter = 0;
        vol_prev = det(E.L);
        
        while iter < max_iters
            iter = iter + 1;
            
            % RsI step
            [A, b] = RsI(E, obstacles, seed);
            Pk = struct('A', A, 'b', b);
            
            % MVIE step
            [L_new, d_new] = MVIE(Pk);
            E_new.L = L_new; 
            E_new.d = d_new;
            vol_new = det(L_new);
            
            disp(['Iteration ', num2str(iter), ', Volume = ', num2str(vol_new)]);
            
            % Check convergence
            if (vol_new - vol_prev)/vol_prev < tol
                E_final = E_new;
                break;
            end
            
            E = E_new;
            vol_prev = vol_new;
        end
        
        if iter == max_iters
            E_final = E;
            warning('FIRI reached maximum iterations without converging.');
        end
    end

    %% RsI: Restrictive Inflation
    function [A, b] = RsI(E, obstacles, seed)
        L_inv = inv(E.L);
        % Use bsxfun for subtraction to handle older MATLAB versions
        seed_tilde = (bsxfun(@minus, seed', E.d))' * L_inv';
        obstacles_tilde = cell(size(obstacles));
        
        for i = 1:length(obstacles)
            obstacles_tilde{i} = (bsxfun(@minus, obstacles{i}', E.d))' * L_inv';
        end
        
        A_list = [];
        b_list = [];
        
        for i = 1:length(obstacles_tilde)
            obs = obstacles_tilde{i};
            if size(unique(obs, 'rows'), 1) < 3
                continue;
            end
            
            [a_tilde, bi_tilde] = solve_minimum_norm(seed_tilde, obs);
            
            a = L_inv' * a_tilde;
            bi = bi_tilde + a' * E.d;
            
            A_list = [A_list, a];
            b_list = [b_list; bi];
        end
        
        [A, b] = remove_redundant_halfspaces(A_list, b_list);
    end

    %% Solve Minimum Norm Problem
    function [a, bi] = solve_minimum_norm(seed_tilde, obs_tilde)
        V = seed_tilde;
        U = obs_tilde;
        
        % Using CasADi to solve the QP
        b = SX.sym('b', 2, 1);
        f = b'*b;
        g = [V*b; -U*b];
        % Corrected lbg and ubg definitions
        lbg = [-inf * ones(size(V,1), 1); -inf * ones(size(U,1), 1)];
        ubg = [ones(size(V,1), 1); -ones(size(U,1), 1)];
        
        qp = struct('x', b, 'f', f, 'g', g);
        solver = qpsol('solver', 'qpoases', qp);
        sol = solver('lbg', lbg, 'ubg', ubg);
        b_opt = full(sol.x);
        
        a = b_opt / (b_opt'*b_opt);
        bi = 1 / (b_opt'*b_opt);
    end

    %% Remove Redundant Halfspaces
    function [A, b] = remove_redundant_halfspaces(A_list, b_list)
        % Simple redundancy check (for demo - full implementation would be more thorough)
        keep = true(1, size(A_list, 2));
        
        for i = 1:size(A_list, 2)
            for j = 1:size(A_list, 2)
                if i ~= j && all(A_list(:,i) == A_list(:,j)) && b_list(i) == b_list(j)
                    keep(i) = false;
                    break;
                end
            end
        end
        
        A = A_list(:, keep);
        b = b_list(keep);
    end

    %% MVIE: Maximum Volume Inscribed Ellipse
    function [L, d] = MVIE(P)
        % For 2D case, use Khachiyan's algorithm adapted for MVIE
        A = P.A;
        b = P.b;
        
        % Get vertices of polytope
        vertices = lcon2vert(A, b)';
        
        % Use modified Khachiyan's algorithm for inner ellipsoid
        [L, d] = inner_ellipsoid(vertices');
    end

    %% Minimum Volume Enclosing Ellipse (Khachiyan's Algorithm)
    function [L, d] = min_vol_ellipse(P, tolerance)
        % P is 2 x N matrix of points
        [d, A] = khachiyan_algorithm(P, tolerance);
        L = chol(A)';
    end

    %% Khachiyan's Algorithm Implementation
    function [c, A] = khachiyan_algorithm(P, tolerance)
        [d, N] = size(P);
        Q = zeros(d+1, N);
        Q(1:d, :) = P;
        Q(d+1, :) = ones(1, N);
        
        % Initialize
        u = ones(1, N)/N;
        err = inf;
        
        % Khachiyan's algorithm
        while err > tolerance
            X = Q * diag(u) * Q';
            % Use backslash instead of inv for numerical stability
            M = diag(Q' * (X \ Q));
            [max_M, j] = max(M);
            step_size = (max_M - d - 1)/((d+1)*(max_M - 1));
            new_u = (1 - step_size)*u;
            new_u(j) = new_u(j) + step_size;
            err = norm(new_u - u);
            u = new_u;
        end
        
        % Compute ellipsoid parameters
        U = diag(u);
        c = P * u';
        A = (1/d) * inv(P * U * P' - c * c');
    end

    %% Inner Ellipsoid Approximation
    function [L, c] = inner_ellipsoid(P)
        % Simplified inner ellipsoid approximation
        % Compute center as centroid
        c = mean(P, 2);
        
        % Compute covariance matrix
        C = cov(P');
        
        % L is Cholesky factor of scaled covariance
        [U,S,~] = svd(C);
        L = U * sqrt(S) * 0.5;  % Scale down to ensure it's inscribed
    end

    %% Generate Obstacles
    function obstacles = generate_nonoverlapping_obstacles(env_size, num_obstacles, min_spacing, seed, seed_spacing)
        obstacles = {};
        for i = 1:num_obstacles
            while true
                r = rand * 5 + 3;
                cx = rand * env_size(1);
                cy = rand * env_size(2);
                angles = sort(rand(5,1)*2*pi);
                points = [cx + r*cos(angles), cy + r*sin(angles)];
                
                if is_valid_obstacle(points, obstacles, seed, seed_spacing)
                    obstacles{end + 1} = points;
                    break;
                end
            end
        end
    end

    %% Check Obstacle Validity
    function valid = is_valid_obstacle(new_obstacle, obstacles, seed, seed_spacing)
        valid = true;
        
        if any(pdist2(seed, new_obstacle) < seed_spacing)
            valid = false;
            return;
        end
        
        for i = 1:numel(obstacles)
            if any(pdist2(obstacles{i}, new_obstacle) < 2.5)
                valid = false;
                return;
            end
        end
    end

    %% Draw Ellipse
    function draw_ellipse(L, d)
        t = linspace(0, 2*pi, 100);
        ellipse_points = [cos(t); sin(t)];
        ellipse_points = L * ellipse_points + d;
        plot(ellipse_points(1,:), ellipse_points(2,:), 'g-', 'LineWidth', 2);
        fill(ellipse_points(1,:), ellipse_points(2,:), 'g', 'FaceAlpha', 0.2);
    end

    %% Convert H-representation to V-representation
    function V = lcon2vert(A, b)
        % This is a placeholder - in practice use a proper implementation
        try
            opts = optimoptions('linprog', 'Display', 'none');
            f = [0, 0];
            lb = [0, 0];
            ub = [env_size(1), env_size(2)];
            V = [];
            
            for i = 1:size(A, 1)
                [~, ~, exitflag] = linprog(f, A(i,:), b(i), [], [], lb, ub, opts);
                if exitflag == 1
                    % Find vertices by intersecting constraints
                    for j = i+1:size(A, 1)
                        Aeq = [A(i,:); A(j,:)];
                        beq = [b(i); b(j)];
                        x = linprog(f, [], [], Aeq, beq, lb, ub, opts);
                        if ~isempty(x)
                            V = [V; x'];
                        end
                    end
                end
            end
            
            % Remove duplicate vertices
            if ~isempty(V)
                V = unique(V, 'rows', 'stable');
            end
        catch
            V = [];
        end
    end
end
